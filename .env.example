# Public demo defaults
MPA_ENVIRONMENT=development
MPA_PUBLIC_DEMO_ONLY=true
MPA_DATABASE_URL=sqlite:///data/runtime/agent.db
MPA_AUTH_MODE=demo

# Production OIDC (required when MPA_ENVIRONMENT=production)
# MPA_AUTH_MODE=oidc
# MPA_OIDC_ISSUER=https://identity.example.com/
# MPA_OIDC_AUDIENCE=manufacturing-project-agent
# MPA_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# MPA_OIDC_ROLE_CLAIM=roles

# Optional OpenAI-compatible structured extraction
MPA_LLM_PROVIDER=offline
# MPA_LLM_PROVIDER=openai_compatible
# MPA_LLM_BASE_URL=https://api.openai.com/v1
# MPA_LLM_MODEL=gpt-5-mini
# MPA_LLM_API_KEY=replace-in-your-secret-manager

MPA_UPLOAD_MAX_MB=15
MPA_HYBRID_BM25_WEIGHT=0.55
MPA_HYBRID_SEMANTIC_WEIGHT=0.35
MPA_HYBRID_EXACT_WEIGHT=0.10
MPA_LOG_LEVEL=INFO
